Name:           penguins-chef
Version:        {{.BaseVersion}}
Release:        {{.Rel}}%{?dist}
Summary:        penguins-chef: cook and configure your Linux distribution
License:        GPLv3
URL:            https://github.com/pieroproietti/penguins-chef

Requires:       git
Requires:       rsync

%define debug_package %{nil}
%define __os_install_post %{nil}

%description
penguins-chef is a lightweight tool to manage and apply system configurations,
desktop environments, and recipes to Linux distributions.

%prep
%build

%install
mkdir -p %{buildroot}/usr
cp -a %{_stagedir}/usr/* %{buildroot}/usr/
if [ -d %{_stagedir}/etc ]; then
    mkdir -p %{buildroot}/etc
    cp -a %{_stagedir}/etc/* %{buildroot}/etc/
fi

%files
/usr/bin/chef
/usr/share/man/man1/*
/usr/share/bash-completion/completions/*
/usr/share/fish/vendor_completions.d/*
/usr/share/zsh/vendor-completions/*

%changelog
* {{.RpmDate}} Piero Proietti <piero.proietti@gmail.com> - {{.BaseVersion}}-{{.Rel}}
- Automated build via penguins-chef builder
